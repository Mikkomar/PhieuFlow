{
  "realm": "phieuflow",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "clientScopes": [
    {
      "name": "forms:read",
      "description": "Read forms via the Hub REST API.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "forms:write",
      "description": "Create and update forms via the Hub REST API.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "submissions:write",
      "description": "Submit form responses via the Hub REST API.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "published-forms:read",
      "description": "Read published forms via the Hub REST API (respondent-facing, read-only).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "phieuflow-hub-audience",
      "description": "Adds the Hub as an accepted audience on the access token.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "phieuflow-hub-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "phieuflow-hub",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "form-builder",
      "description": "The form-builder service, calling the Hub REST API with an OAuth2 client-credentials token (ADR 0005).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "form-builder-dev-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "forms:read",
        "phieuflow-hub-audience"
      ],
      "optionalClientScopes": [
        "forms:write",
        "submissions:write"
      ]
    },
    {
      "clientId": "form-filler",
      "description": "The form-filler service, calling the Hub REST API with an OAuth2 client-credentials token (ADR 0005). Scoped to published forms only — it must never read draft/unpublished content.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "form-filler-dev-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "published-forms:read",
        "phieuflow-hub-audience"
      ],
      "optionalClientScopes": []
    }
  ]
}
