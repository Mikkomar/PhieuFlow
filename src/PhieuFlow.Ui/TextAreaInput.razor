<textarea rows="3"
          placeholder="@Placeholder"
          disabled="@Disabled"
          @oninput="HandleInput"
          class="w-full resize-y rounded-md border border-border-control bg-white px-[12px] py-[10px] text-[13.5px] leading-[1.5] text-text placeholder:text-text-faintest-2 hover:border-border-control-hover focus:outline-2 focus:outline-accent focus:outline-offset-2">@Value</textarea>

@code {
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private Task HandleInput(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString());
}
