<input type="@Type"
       value="@Value"
       placeholder="@Placeholder"
       disabled="@Disabled"
       @oninput="HandleInput"
       class="h-[38px] w-full rounded-md border border-border-control bg-white px-[12px] text-[13.5px] text-text placeholder:text-text-faintest-2 hover:border-border-control-hover focus:outline-2 focus:outline-accent focus:outline-offset-2" />

@code {
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public string Type { get; set; } = "text";

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private Task HandleInput(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString());
}
