@using PhieuFlow.Core.Entities

<div class="fixed inset-0 z-20" @onclick="@(() => OnClose.InvokeAsync())"></div>
<div role="menu" @onkeydown="OnKeyDown"
     class="@($"absolute z-30 flex w-[210px] flex-col gap-px rounded-lg border border-border bg-white p-[5px] shadow-[0_8px_24px_rgba(16,24,24,0.12)] {AnchorClasses}")">
    @for (var i = 0; i < Types.Length; i++)
    {
        var typeDef = Types[i];
        var itemIndex = i;
        <button type="button" role="menuitem" @ref="_itemRefs[itemIndex]"
                @onclick="@(() => OnAdd.InvokeAsync(typeDef.Create()))"
                class="flex w-full items-center gap-[9px] rounded-md px-[9px] py-[7px] text-left text-[12.5px] text-text-body hover:bg-surface-subtle hover:text-accent">
            <span class="flex h-[18px] w-[18px] flex-none items-center justify-center rounded-[5px] bg-border-row font-mono text-[9.5px] font-medium text-text-soft">@typeDef.Glyph</span>
            @typeDef.Label
        </button>
    }
</div>

@code {
    public static readonly (string Label, string Glyph, Func<Question> Create)[] Types =
    {
        ("Text area", "Aa", () => new TextAreaQuestion { Id = Guid.NewGuid(), Text = string.Empty }),
        ("Dropdown", "▾", () => new DropDownQuestion { Id = Guid.NewGuid(), Text = string.Empty, Options = new List<QuestionOption> { new() { Id = Guid.NewGuid(), Label = string.Empty } } }),
        ("Checkbox", "☑", () => new CheckboxQuestion { Id = Guid.NewGuid(), Text = string.Empty, Label = string.Empty }),
        ("Radio buttons", "◉", () => new RadioButtonQuestion { Id = Guid.NewGuid(), Text = string.Empty, Options = new List<QuestionOption> { new() { Id = Guid.NewGuid(), Label = string.Empty } } }),
        ("Checkbox group", "☰", () => new CheckBoxGroupQuestion { Id = Guid.NewGuid(), Text = string.Empty, Options = new List<QuestionOption> { new() { Id = Guid.NewGuid(), Label = string.Empty } } }),
    };

    [Parameter, EditorRequired]
    public EventCallback<Question> OnAdd { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public string AnchorClasses { get; set; } = "top-[34px] right-0";

    private readonly ElementReference[] _itemRefs = new ElementReference[Types.Length];
    private int _focusIndex;
    private bool _hasFocused;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_hasFocused)
        {
            _hasFocused = true;
            await _itemRefs[0].FocusAsync();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                await OnClose.InvokeAsync();
                break;
            case "ArrowDown":
                _focusIndex = (_focusIndex + 1) % Types.Length;
                await _itemRefs[_focusIndex].FocusAsync();
                break;
            case "ArrowUp":
                _focusIndex = _focusIndex <= 0 ? Types.Length - 1 : _focusIndex - 1;
                await _itemRefs[_focusIndex].FocusAsync();
                break;
        }
    }
}
