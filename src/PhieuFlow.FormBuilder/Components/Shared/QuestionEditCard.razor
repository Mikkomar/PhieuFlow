@using PhieuFlow.Core.Entities

<div class="@RootClasses" @onkeydown="OnRowKeyDown">
    <div @onclick="@(() => OnToggle.InvokeAsync())"
         class="relative flex h-[42px] cursor-pointer items-center gap-[10px] px-3 outline-none hover:bg-surface-subtle focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent"
         tabindex="0">
        <div class="absolute inset-x-0 top-0 z-10 h-1/2"
             @ondragover="@(() => OnDragOverTop.InvokeAsync())" @ondragover:preventDefault="true"
             @ondrop="@(() => OnDrop.InvokeAsync())"></div>
        <div class="absolute inset-x-0 bottom-0 z-10 h-1/2"
             @ondragover="@(() => OnDragOverBottom.InvokeAsync())" @ondragover:preventDefault="true"
             @ondrop="@(() => OnDrop.InvokeAsync())"></div>
        <span draggable="true"
              @onclick:stopPropagation="true"
              @ondragstart="@(() => OnDragStart.InvokeAsync())"
              @ondragend="@(() => OnDragEnd.InvokeAsync())"
              aria-hidden="true"
              class="relative z-20 flex w-[14px] flex-none cursor-grab items-center text-text-faintest-2 hover:text-text-faint active:cursor-grabbing">
            <Blazicon Svg="Lucide.GripVertical" class="text-[13px]" />
        </span>
        <span class="w-4 flex-none text-right font-mono text-[11px] text-text-faintest">@Number</span>
        <span class="@TextLabelClasses">@TextLabel</span>
        @if (Question.IsRequired)
        {
            <span class="flex-none font-mono text-[9.5px] tracking-[0.06em] text-accent uppercase">Required</span>
        }
        <span class="flex-none font-mono text-[9.5px] tracking-[0.07em] text-text-faintest uppercase whitespace-nowrap">@TypeLabel(Question)</span>
        <span class="@ChevronClasses" aria-hidden="true">
            <Blazicon Svg="Lucide.ChevronRight" class="text-[13px]" />
        </span>
    </div>

    @if (Expanded)
    {
        <div class="flex flex-col gap-[13px] border-t border-border-row p-[14px_12px_14px_52px]">
            <div class="flex flex-col gap-[6px]">
                <label class="text-[12px] font-semibold text-text-body">Question text</label>
                <input value="@Question.Text"
                       @oninput="OnTextInput"
                       @ref="_textInputRef"
                       placeholder="e.g. Which department are you joining?"
                       class="h-[32px] w-full max-w-[520px] rounded-md border border-border-control bg-page-bg px-[10px] text-[13px] text-text outline-none focus:border-accent placeholder:text-text-faint" />
            </div>

            @if (Question is ChoiceQuestion choiceQuestion)
            {
                <ChoiceOptionsEditor Question="choiceQuestion" OnChanged="OnChanged" />
            }

            @if (Question is TextAreaQuestion textAreaQuestion)
            {
                <TextAreaQuestionEditor Question="textAreaQuestion" OnChanged="OnChanged" />
            }

            @if (Question is CheckboxQuestion checkboxQuestion)
            {
                <CheckboxQuestionEditor Question="checkboxQuestion" OnChanged="OnChanged" />
            }

            @if (Question is CheckBoxGroupQuestion checkBoxGroupQuestion)
            {
                <CheckBoxGroupQuestionEditor Question="checkBoxGroupQuestion" OnChanged="OnChanged" />
            }

            @if (Question is NumberQuestion numberQuestion)
            {
                <NumberQuestionEditor Question="numberQuestion" OnChanged="OnChanged" />
            }

            @if (Question is CalendarQuestion calendarQuestion)
            {
                <CalendarQuestionEditor Question="calendarQuestion" OnChanged="OnChanged" />
            }

            <div class="flex items-center justify-between gap-4 pt-[2px]">
                <label class="flex items-center gap-2 text-[12.5px] text-text-body">
                    <input type="checkbox" checked="@Question.IsRequired" @onchange="OnRequiredChanged" class="h-[14px] w-[14px] accent-accent" />
                    Required
                </label>
                <button type="button" @onclick="@(() => OnRemove.InvokeAsync(Question))"
                        class="h-7 rounded-md border border-danger-border bg-white px-[11px] text-[12px] font-medium text-danger hover:border-danger-border-hover hover:bg-danger-surface">
                    Delete question
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public Question Question { get; set; } = null!;

    [Parameter, EditorRequired]
    public int Number { get; set; }

    [Parameter, EditorRequired]
    public bool Expanded { get; set; }

    [Parameter]
    public bool Dragging { get; set; }

    [Parameter]
    public bool AutoFocusText { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnToggle { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<Question> OnRemove { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public EventCallback OnDragStart { get; set; }

    [Parameter]
    public EventCallback OnDragEnd { get; set; }

    [Parameter]
    public EventCallback OnDragOverTop { get; set; }

    [Parameter]
    public EventCallback OnDragOverBottom { get; set; }

    [Parameter]
    public EventCallback OnDrop { get; set; }

    [Parameter]
    public EventCallback<int> OnKeyMove { get; set; }

    private ElementReference _textInputRef;
    private bool _hasAutoFocused;

    public static string TypeLabel(Question question) => question switch
    {
        TextAreaQuestion => "Text area",
        CheckboxQuestion => "Checkbox",
        DropDownQuestion => "Dropdown",
        RadioButtonQuestion => "Radio buttons",
        CheckBoxGroupQuestion => "Checkbox group",
        NumberQuestion => "Number",
        CalendarQuestion => "Calendar",
        _ => "Question",
    };

    private string TextLabel => string.IsNullOrWhiteSpace(Question.Text) ? "Untitled question" : Question.Text;

    private string TextLabelClasses => "min-w-0 flex-1 overflow-hidden text-ellipsis whitespace-nowrap text-[13px] font-medium "
        + (string.IsNullOrWhiteSpace(Question.Text) ? "text-text-faintest-2" : "text-text");

    private string RootClasses => "rounded-lg border bg-white transition-opacity overflow-hidden "
        + (Expanded ? "border-accent " : "border-border-control ")
        + (Dragging ? "opacity-40" : "opacity-100");

    private string ChevronClasses => "flex w-4 flex-none items-center justify-center transition-transform "
        + (Expanded ? "rotate-90 text-accent" : "text-text-faintest-2");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (AutoFocusText && Expanded && !_hasAutoFocused)
        {
            _hasAutoFocused = true;
            await _textInputRef.FocusAsync();
        }
    }

    private async Task OnRowKeyDown(KeyboardEventArgs e)
    {
        if (!e.AltKey)
        {
            return;
        }

        switch (e.Key)
        {
            case "ArrowUp":
                await OnKeyMove.InvokeAsync(-1);
                break;
            case "ArrowDown":
                await OnKeyMove.InvokeAsync(1);
                break;
        }
    }

    private void OnTextInput(ChangeEventArgs e)
    {
        Question.Text = e.Value?.ToString() ?? string.Empty;
        OnChanged.InvokeAsync();
    }

    private void OnRequiredChanged(ChangeEventArgs e)
    {
        Question.IsRequired = e.Value is bool value && value;
        OnChanged.InvokeAsync();
    }
}
