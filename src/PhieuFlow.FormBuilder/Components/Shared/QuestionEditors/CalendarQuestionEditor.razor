@inherits MinMaxEditorBase

<div class="flex max-w-[340px] flex-col gap-[5px]">
    <div class="flex gap-3">
        <div class="flex flex-1 flex-col gap-[5px]">
            <span class="text-[11.5px] text-text-faint">Min date</span>
            <input type="date" aria-label="Min date" value="@(Question.MinDate?.ToString("yyyy-MM-dd") ?? string.Empty)" @ref="MinRef"
                   @oninput="@(e => Edit(() => Question.MinDate = MinMaxValidation.ParseNullableDate(e.Value)))"
                   aria-invalid="@(Invalid ? "true" : null)"
                   class="@MinMaxValidation.InputClasses(Invalid)" />
        </div>
        <div class="flex flex-1 flex-col gap-[5px]">
            <span class="text-[11.5px] text-text-faint">Max date</span>
            <input type="date" aria-label="Max date" value="@(Question.MaxDate?.ToString("yyyy-MM-dd") ?? string.Empty)" @ref="MaxRef"
                   @oninput="@(e => Edit(() => Question.MaxDate = MinMaxValidation.ParseNullableDate(e.Value)))"
                   aria-invalid="@(Invalid ? "true" : null)"
                   class="@MinMaxValidation.InputClasses(Invalid)" />
        </div>
    </div>
    @if (MinMaxValidation.ExceedsMax(Question.MinDate, Question.MaxDate))
    {
        <span class="text-[11.5px] text-danger">Min date cannot be after max date.</span>
    }
    @foreach (var issue in Question.Issues)
    {
        <span class="text-[11.5px] text-danger">@issue.Message</span>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public CalendarQuestionEditModel Question { get; set; } = null!;

    protected override IReadOnlyList<ValidationIssue> Issues => Question.Issues;

    private bool Invalid => MinMaxValidation.ExceedsMax(Question.MinDate, Question.MaxDate) || Question.Issues.Count > 0;

    private void Edit(Action apply)
    {
        apply();
        Question.Issues.Clear();
        OnChanged.InvokeAsync();
    }
}
