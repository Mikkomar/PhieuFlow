<div class="flex max-w-[340px] flex-col gap-[5px]">
    <div class="flex gap-3">
        <div class="flex flex-1 flex-col gap-[5px]">
            <span class="text-[11.5px] text-text-faint">Min length</span>
            <input type="number" min="0" value="@(Question.MinLength?.ToString() ?? string.Empty)"
                   @oninput="@(e => { Question.MinLength = MinMaxValidation.ParseNullableInt(e.Value); OnChanged.InvokeAsync(); })"
                   class="@MinMaxValidation.InputClasses(Invalid)" />
        </div>
        <div class="flex flex-1 flex-col gap-[5px]">
            <span class="text-[11.5px] text-text-faint">Max length</span>
            <input type="number" min="0" value="@(Question.MaxLength?.ToString() ?? string.Empty)"
                   @oninput="@(e => { Question.MaxLength = MinMaxValidation.ParseNullableInt(e.Value); OnChanged.InvokeAsync(); })"
                   class="@MinMaxValidation.InputClasses(Invalid)" />
        </div>
    </div>
    @if (Invalid)
    {
        <span class="text-[11.5px] text-danger">Min length cannot be greater than max length.</span>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public TextAreaQuestion Question { get; set; } = null!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private bool Invalid => MinMaxValidation.ExceedsMax(Question.MinLength, Question.MaxLength);
}
