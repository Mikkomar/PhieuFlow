<div class="flex flex-col gap-[6px]">
    <label class="text-[12px] font-semibold text-text-body">Checkbox label</label>
    <input value="@Question.Label"
           @oninput="OnLabelInput"
           placeholder="e.g. I agree to the terms"
           class="h-[32px] w-full max-w-[520px] rounded-md border border-border-control bg-page-bg px-[10px] text-[13px] text-text outline-none focus:border-accent placeholder:text-text-faint" />
</div>

@code {
    [Parameter, EditorRequired]
    public CheckboxQuestionEditModel Question { get; set; } = null!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private void OnLabelInput(ChangeEventArgs e)
    {
        Question.Edit(() => Question.Label = e.Value?.ToString() ?? string.Empty);
        OnChanged.InvokeAsync();
    }
}
