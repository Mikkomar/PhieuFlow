@inherits MinMaxEditorBase

<div class="flex max-w-[340px] flex-col gap-[5px]">
    <div class="flex gap-3">
        <div class="flex flex-1 flex-col gap-[5px]">
            <span class="text-[11.5px] text-text-faint">Min value</span>
            <input type="number" aria-label="Min value" value="@(Question.Min?.ToString() ?? string.Empty)" @ref="MinRef"
                   @oninput="@(e => Edit(() => Question.Min = MinMaxValidation.ParseNullableDecimal(e.Value)))"
                   aria-invalid="@(Invalid ? "true" : null)"
                   class="@MinMaxValidation.InputClasses(Invalid)" />
        </div>
        <div class="flex flex-1 flex-col gap-[5px]">
            <span class="text-[11.5px] text-text-faint">Max value</span>
            <input type="number" aria-label="Max value" value="@(Question.Max?.ToString() ?? string.Empty)" @ref="MaxRef"
                   @oninput="@(e => Edit(() => Question.Max = MinMaxValidation.ParseNullableDecimal(e.Value)))"
                   aria-invalid="@(Invalid ? "true" : null)"
                   class="@MinMaxValidation.InputClasses(Invalid)" />
        </div>
    </div>
    @if (MinMaxValidation.ExceedsMax(Question.Min, Question.Max))
    {
        <span class="text-[11.5px] text-danger">Min value cannot be greater than max value.</span>
    }
    @foreach (var issue in Question.Issues)
    {
        <span class="text-[11.5px] text-danger">@issue.Message</span>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public NumberQuestionEditModel Question { get; set; } = null!;

    protected override IReadOnlyList<ValidationIssue> Issues => Question.Issues;

    private bool Invalid => MinMaxValidation.ExceedsMax(Question.Min, Question.Max) || Question.Issues.Count > 0;

    private void Edit(Action apply)
    {
        apply();
        Question.Issues.Clear();
        OnChanged.InvokeAsync();
    }
}
