@inherits MinMaxEditorBase

<div class="flex max-w-[340px] flex-col gap-[5px]">
    <div class="flex gap-3">
        <div class="flex flex-1 flex-col gap-[5px]">
            <span class="text-[11.5px] text-text-faint">Min value</span>
            <input type="number" aria-label="Min value" value="@_minText" @ref="MinRef"
                   @oninput="@(e => OnMinInput(e.Value))"
                   aria-invalid="@(Invalid ? "true" : null)"
                   class="@MinMaxValidation.InputClasses(Invalid)" />
        </div>
        <div class="flex flex-1 flex-col gap-[5px]">
            <span class="text-[11.5px] text-text-faint">Max value</span>
            <input type="number" aria-label="Max value" value="@_maxText" @ref="MaxRef"
                   @oninput="@(e => OnMaxInput(e.Value))"
                   aria-invalid="@(Invalid ? "true" : null)"
                   class="@MinMaxValidation.InputClasses(Invalid)" />
        </div>
    </div>
    @if (MinMaxValidation.ExceedsMax(Question.Min, Question.Max))
    {
        <span class="text-[11.5px] text-danger">Min value cannot be greater than max value.</span>
    }
    @foreach (var issue in Question.Issues)
    {
        <span class="text-[11.5px] text-danger">@issue.Message</span>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public NumberQuestionEditModel Question { get; set; } = null!;

    protected override IHasIssues Node => Question;

    private bool Invalid => MinMaxValidation.ExceedsMax(Question.Min, Question.Max) || Question.Issues.Count > 0;

    private string _minText = string.Empty;
    private string _maxText = string.Empty;

    protected override void OnInitialized()
    {
        _minText = Question.Min?.ToString() ?? string.Empty;
        _maxText = Question.Max?.ToString() ?? string.Empty;
    }

    private void OnMinInput(object? value)
    {
        _minText = value?.ToString() ?? string.Empty;
        Edit(() => Question.Min = MinMaxValidation.ParseNullableDecimal(_minText));
    }

    private void OnMaxInput(object? value)
    {
        _maxText = value?.ToString() ?? string.Empty;
        Edit(() => Question.Max = MinMaxValidation.ParseNullableDecimal(_maxText));
    }
}
