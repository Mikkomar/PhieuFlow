@page "/Error"
@layout MainLayout
@using System.Diagnostics

<PageTitle>Something went wrong</PageTitle>

<EmptyStateBlock Tone="EmptyStateTone.Danger"
                 Heading="Something went wrong"
                 Body="The page couldn't finish loading. Nothing you had saved is affected."
                 Meta="@(ShowRequestId ? $"Request {RequestId}" : null)">
    <a href="/" class="@EmptyStateBlock.PrimaryClasses">Back to all forms</a>
</EmptyStateBlock>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
