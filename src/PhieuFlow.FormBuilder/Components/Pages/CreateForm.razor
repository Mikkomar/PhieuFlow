@page "/forms/new"
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>New form</PageTitle>

<header class="border-b border-border bg-surface px-8 pt-5 pb-5">
    <div class="flex items-center gap-2">
        <button type="button" @onclick="@(() => Nav.NavigateTo("/"))"
                class="flex h-7 w-7 flex-none items-center justify-center rounded-md text-text-faint hover:bg-surface-subtle hover:text-text">
            <Blazicon Svg="Lucide.ArrowLeft" class="text-sm" />
        </button>
        <div class="flex flex-col gap-1">
            <div class="font-mono text-[10px] tracking-[0.07em] text-text-faintest uppercase">PhieuFlow / Forms / New form</div>
            <h1 class="m-0 text-[21px] font-semibold tracking-[-0.02em]">New form</h1>
        </div>
    </div>
</header>

<div class="flex-1 px-8 pt-6 pb-10">
    <div class="rounded-lg border border-border bg-surface p-6 shadow-[0_1px_2px_rgba(16,24,24,0.04)]">
        <EditForm Model="_model" OnValidSubmit="HandleValidSubmit" class="flex flex-col gap-5">
            <DataAnnotationsValidator />

            <div class="flex flex-col gap-[6px]">
                <label for="title" class="text-[13px] font-semibold text-text">Title</label>
                <div class="flex h-[34px] items-center rounded-md border border-border-control bg-page-bg px-[10px] focus-within:border-accent">
                    <InputText id="title" @bind-Value="_model.Title"
                               placeholder="e.g. Employee onboarding checklist"
                               class="w-full border-none bg-transparent text-[13px] text-text outline-none placeholder:text-text-faint" />
                </div>
                <ValidationMessage For="@(() => _model.Title)" class="text-[12px] text-danger" />
            </div>

            <div class="flex flex-col gap-[6px]">
                <label for="description" class="text-[13px] font-semibold text-text">Description</label>
                <div class="rounded-md border border-border-control bg-page-bg px-[10px] py-2 focus-within:border-accent">
                    <InputTextArea id="description" @bind-Value="_model.Description"
                                   placeholder="What is this form for?"
                                   rows="3"
                                   class="w-full resize-none border-none bg-transparent text-[13px] text-text outline-none placeholder:text-text-faint" />
                </div>
                <ValidationMessage For="@(() => _model.Description)" class="text-[12px] text-danger" />
            </div>

            <div class="mt-1 flex items-center justify-end gap-[10px]">
                <button type="button" @onclick="@(() => Nav.NavigateTo("/"))"
                        class="h-[34px] rounded-md border border-border-control bg-white px-4 text-[13px] font-medium text-text-body hover:border-border-control-hover">
                    Cancel
                </button>
                <button type="submit"
                        class="h-[34px] rounded-md border border-accent bg-accent px-4 text-[13px] font-semibold text-white hover:border-accent-hover hover:bg-accent-hover">
                    Create form
                </button>
            </div>
        </EditForm>
    </div>

    <div class="mt-6 rounded-lg border border-border bg-surface p-6 shadow-[0_1px_2px_rgba(16,24,24,0.04)]">
        <div class="flex items-center justify-between">
            <span class="font-mono text-[10px] tracking-[0.07em] text-text-faintest uppercase">Pages</span>
            <button type="button" @onclick="AddPage"
                    class="flex h-7 items-center gap-[6px] rounded-md border border-border-control bg-white px-[10px] text-[12.5px] font-medium text-text-body hover:border-border-control-hover">
                <Blazicon Svg="Lucide.Plus" class="text-xs" />
                Add page
            </button>
        </div>

        <div class="mt-3 flex flex-col gap-3">
            @for (var i = 0; i < _model.Pages.Count; i++)
            {
                var page = _model.Pages[i];
                var pageNumber = i + 1;
                var questionCount = page.Questions.Count;
                <div class="rounded-md border border-border-row bg-surface-subtle p-3">
                    <div class="flex items-center justify-between">
                        <div class="flex flex-col gap-0.5">
                            <span class="text-[13px] font-semibold text-text">Page @pageNumber</span>
                            <span class="text-[11.5px] text-text-faint">@(questionCount == 1 ? "1 question" : $"{questionCount} questions")</span>
                        </div>
                        <div class="flex items-center gap-[6px]">
                            <div class="relative">
                                <button type="button" @onclick="@(() => ToggleQuestionTypePicker(page))"
                                        class="flex h-7 items-center gap-[6px] rounded-md border border-border-control bg-white px-[10px] text-[12px] font-medium text-text-body hover:border-border-control-hover">
                                    <Blazicon Svg="Lucide.Plus" class="text-xs" />
                                    Add question
                                </button>

                                @if (_pickingTypeForPageId == page.Id)
                                {
                                    <div class="absolute right-full top-0 z-10 mr-2 w-[160px] rounded-md border border-border bg-white p-1 shadow-[0_4px_12px_rgba(16,24,24,0.12)]">
                                        <button type="button" @onclick="@(() => AddQuestion(page, new TextAreaQuestion { Id = Guid.NewGuid(), Text = string.Empty }))"
                                                class="block w-full rounded-md px-[10px] py-[6px] text-left text-[12.5px] text-text-body hover:bg-surface-subtle">
                                            Text area
                                        </button>
                                        <button type="button" @onclick="@(() => AddQuestion(page, new DropDownQuestion { Id = Guid.NewGuid(), Text = string.Empty }))"
                                                class="block w-full rounded-md px-[10px] py-[6px] text-left text-[12.5px] text-text-body hover:bg-surface-subtle">
                                            Dropdown
                                        </button>
                                        <button type="button" @onclick="@(() => AddQuestion(page, new CheckboxQuestion { Id = Guid.NewGuid(), Text = string.Empty }))"
                                                class="block w-full rounded-md px-[10px] py-[6px] text-left text-[12.5px] text-text-body hover:bg-surface-subtle">
                                            Checkbox
                                        </button>
                                        <button type="button" @onclick="@(() => AddQuestion(page, new RadioButtonQuestion { Id = Guid.NewGuid(), Text = string.Empty }))"
                                                class="block w-full rounded-md px-[10px] py-[6px] text-left text-[12.5px] text-text-body hover:bg-surface-subtle">
                                            Radio buttons
                                        </button>
                                        <button type="button" @onclick="@(() => AddQuestion(page, new CheckBoxGroupQuestion { Id = Guid.NewGuid(), Text = string.Empty }))"
                                                class="block w-full rounded-md px-[10px] py-[6px] text-left text-[12.5px] text-text-body hover:bg-surface-subtle">
                                            Checkbox group
                                        </button>
                                    </div>
                                }
                            </div>
                            <button type="button" disabled="@(_model.Pages.Count <= 1)" @onclick="@(() => DeletePage(page))"
                                    class="flex h-7 w-7 flex-none items-center justify-center rounded-md border border-border-control bg-white text-text-soft enabled:hover:border-danger-border-hover enabled:hover:text-danger disabled:cursor-default disabled:text-text-faintest-2">
                                <Blazicon Svg="Lucide.Trash2" class="text-sm" />
                            </button>
                        </div>
                    </div>

                    @if (page.Questions.Count > 0)
                    {
                        <div class="mt-3 flex flex-col gap-2">
                            @foreach (var question in page.Questions)
                            {
                                <div class="@RowClasses(question)"
                                     @ondragenter="@(() => _dragOverQuestion = question)"
                                     @ondragover="@(() => { })" @ondragover:preventDefault="true"
                                     @ondrop="@(() => HandleDrop(page, question))">
                                    <span draggable="true"
                                          @ondragstart="@(() => _draggedQuestion = question)"
                                          @ondragend="@(() => { _draggedQuestion = null; _dragOverQuestion = null; })"
                                          class="mt-3 flex h-7 w-5 flex-none cursor-grab items-center justify-center text-text-faintest-2 hover:text-text-faint active:cursor-grabbing">
                                        <Blazicon Svg="Lucide.GripVertical" class="text-sm" />
                                    </span>
                                    <div class="min-w-0 flex-1">
                                        <QuestionEditCard Question="question" OnRemove="@(q => RemoveQuestion(page, q))" />
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private readonly CreateFormModel _model = new();
    private Guid? _pickingTypeForPageId;
    private Question? _draggedQuestion;
    private Question? _dragOverQuestion;

    private void HandleValidSubmit()
    {
        Nav.NavigateTo("/");
    }

    private void AddPage()
    {
        _model.Pages.Add(new FormPage { Id = Guid.NewGuid() });
    }

    private async Task DeletePage(FormPage page)
    {
        if (_model.Pages.Count <= 1)
        {
            return;
        }

        if (page.Questions.Count > 0)
        {
            var count = page.Questions.Count;
            var confirmed = await JS.InvokeAsync<bool>("confirm",
                $"Delete this page? It has {count} question{(count == 1 ? "" : "s")} that will be removed too.");
            if (!confirmed)
            {
                return;
            }
        }

        _model.Pages.Remove(page);
        if (_pickingTypeForPageId == page.Id)
        {
            _pickingTypeForPageId = null;
        }
    }

    private void ToggleQuestionTypePicker(FormPage page)
    {
        _pickingTypeForPageId = _pickingTypeForPageId == page.Id ? null : page.Id;
    }

    private void AddQuestion(FormPage page, Question question)
    {
        page.Questions.Add(question);
        _pickingTypeForPageId = null;
    }

    private void RemoveQuestion(FormPage page, Question question)
    {
        page.Questions.Remove(question);
    }

    private void HandleDrop(FormPage page, Question targetQuestion)
    {
        if (_draggedQuestion is null || _draggedQuestion == targetQuestion)
        {
            _draggedQuestion = null;
            _dragOverQuestion = null;
            return;
        }

        var ordered = page.Questions.ToList();
        var draggedIndex = ordered.IndexOf(_draggedQuestion);
        var targetIndex = ordered.IndexOf(targetQuestion);
        if (draggedIndex < 0 || targetIndex < 0)
        {
            _draggedQuestion = null;
            _dragOverQuestion = null;
            return;
        }

        ordered.RemoveAt(draggedIndex);
        ordered.Insert(draggedIndex < targetIndex ? targetIndex - 1 : targetIndex, _draggedQuestion);
        page.Questions = ordered;
        _draggedQuestion = null;
        _dragOverQuestion = null;
    }

    private string RowClasses(Question question)
    {
        var classes = "flex items-start gap-1 rounded-md transition-colors";

        if (question == _draggedQuestion)
        {
            classes += " opacity-40";
        }

        if (_draggedQuestion is not null && question == _dragOverQuestion && question != _draggedQuestion)
        {
            classes += " outline outline-2 outline-accent outline-offset-2";
        }

        return classes;
    }

    private sealed class CreateFormModel
    {
        [Required(ErrorMessage = "Title is required.")]
        [StringLength(120, ErrorMessage = "Title must be 120 characters or fewer.")]
        public string Title { get; set; } = string.Empty;

        [StringLength(500, ErrorMessage = "Description must be 500 characters or fewer.")]
        public string? Description { get; set; }

        public List<FormPage> Pages { get; } = new() { new FormPage { Id = Guid.NewGuid() } };
    }
}
