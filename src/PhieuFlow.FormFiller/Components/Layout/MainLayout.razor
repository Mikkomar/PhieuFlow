@inherits LayoutComponentBase

<div class="flex min-h-screen flex-col bg-page-bg">
    <header class="flex h-[59px] flex-none items-center border-b border-border bg-surface px-8">
        <Wordmark />
    </header>

    <main class="flex flex-1 flex-col">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    <div class="row">
        <span class="message">Something went wrong. Reload to continue.</span>
        <a href="." class="reload">Reload</a>
        <button type="button" class="dismiss" aria-label="Dismiss">&times;</button>
    </div>
</div>
