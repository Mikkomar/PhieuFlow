@page "/forms/{FormId:guid}"
@inject IHubFormsClient HubFormsClient
@inject ISubmissionPublisher SubmissionPublisher
@inject SubmissionValidator SubmissionValidator
@inject ILogger<FillPage> Logger

@if (_loading)
{
    <div class="mx-auto max-w-[680px] px-8 pt-[44px] text-[13.5px] text-text-faintest">Loading&hellip;</div>
}
else if (_form is null)
{
    <FormUnavailable />
}
else if (_submitted)
{
    <div class="mx-auto flex w-full max-w-[520px] flex-col items-center gap-[18px] px-8 pt-[72px] pb-[96px] text-center">
        <div class="flex h-[44px] w-[44px] flex-none items-center justify-center rounded-full border border-border bg-surface">
            <Blazicon Svg="Lucide.Check" class="text-[18px] text-text-faint" aria-hidden="true" />
        </div>

        <div class="flex flex-col gap-[6px]">
            <h1 class="text-[20px] font-semibold tracking-[-0.015em] text-text">Your response was received</h1>
            <p class="text-[13.5px] leading-[1.6] text-text-soft">Thanks for filling out @_form.Title. You can close this tab.</p>
        </div>
    </div>
}
else
{
    <div class="mx-auto flex w-full max-w-[680px] flex-col gap-[22px] px-8 pt-[40px] pb-[56px]">
        <div class="flex flex-col gap-[6px]">
            <h1 class="text-[22px] font-semibold tracking-[-0.015em] text-text">@_form.Title</h1>
            @if (!string.IsNullOrWhiteSpace(_form.Description))
            {
                <p class="text-[13.5px] leading-[1.55] text-text-soft text-pretty">@_form.Description</p>
            }
        </div>

        <PageStepper Labels="PageLabels" CurrentPageIndex="_currentPageIndex" />

        <div class="flex flex-col gap-[26px] rounded-lg border border-border bg-surface p-[28px_30px]">
            <div class="flex flex-col gap-[4px] border-b border-border-row pb-[4px]">
                <span class="text-[15.5px] font-semibold tracking-[-0.01em] text-text">@ActivePageTitle</span>
            </div>

            @foreach (var question in ActivePage.Questions)
            {
                <QuestionInput Question="question"
                               Value="_answers.GetValueOrDefault(question.Id)"
                               Error="@_errors.GetValueOrDefault(question.Id)"
                               ValueChanged="v => OnAnswerChanged(question.Id, v)" />
            }
        </div>

        @if (_errors.Count > 0)
        {
            <p class="text-[12px] text-danger" role="alert">
                Check the highlighted question@(_errors.Count == 1 ? "" : "s") before continuing.
            </p>
        }

        <div class="flex items-center justify-between">
            @if (_currentPageIndex > 0)
            {
                <button type="button" @onclick="GoBack"
                        class="flex h-[38px] items-center gap-[7px] rounded-md border border-border-control bg-white px-[16px] text-[13px] font-medium text-text-body hover:border-border-control-hover">
                    <Blazicon Svg="Lucide.ChevronLeft" class="text-[13px]" aria-hidden="true" />
                    Back
                </button>
            }
            else
            {
                <span></span>
            }

            <div class="flex items-center gap-[14px]">
                <span class="font-mono text-[10.5px] text-text-faintest">Step @(_currentPageIndex + 1) of @_form.Pages.Count</span>
                @if (IsLastPage)
                {
                    <button type="button" @onclick="Submit" disabled="@_submitting"
                            class="h-[38px] rounded-md border border-accent bg-accent px-[20px] text-[13px] font-semibold text-white hover:border-accent-hover hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-60">
                        Submit
                    </button>
                }
                else
                {
                    <button type="button" @onclick="GoContinue"
                            class="h-[38px] rounded-md border border-accent bg-accent px-[20px] text-[13px] font-semibold text-white hover:border-accent-hover hover:bg-accent-hover">
                        Continue
                    </button>
                }
            </div>
        </div>

        <p class="text-center text-[11.5px] text-text-faintest">Responses are anonymous. Nothing is submitted until you finish page @_form.Pages.Count.</p>
    </div>
}

@code {
    [Parameter]
    public Guid FormId { get; set; }

    private PublishedFormDto? _form;
    private bool _loading = true;
    private int _currentPageIndex;
    private bool _submitting;
    private bool _submitted;
    private readonly Dictionary<Guid, object?> _answers = [];

    // Populated by SubmissionValidator on a failed Submit / Continue; keyed by question id.
    // Nothing is published while this is non-empty.
    private Dictionary<Guid, string> _errors = [];

    private FormPageDto ActivePage => _form!.Pages[_currentPageIndex];

    private string ActivePageTitle => string.IsNullOrWhiteSpace(ActivePage.Title)
        ? $"Page {_currentPageIndex + 1}"
        : ActivePage.Title!;

    private bool IsLastPage => _form is not null && _currentPageIndex == _form.Pages.Count - 1;

    private List<string> PageLabels => _form!.Pages
        .Select((p, i) => string.IsNullOrWhiteSpace(p.Title) ? $"Page {i + 1}" : p.Title!)
        .ToList();

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _currentPageIndex = 0;
        _submitting = false;
        _submitted = false;
        _answers.Clear();
        _errors = [];
        try
        {
            _form = await HubFormsClient.GetPublishedFormByIdAsync(FormId);
        }
        catch (HttpRequestException ex)
        {
            // Hub down / 5xx / network drop — leave _form null so FormUnavailable renders.
            Logger.LogError(ex, "Loading published form {FormId} for filling failed.", FormId);
            _form = null;
        }
        _loading = false;
    }

    private void GoBack()
    {
        if (_currentPageIndex > 0)
        {
            _currentPageIndex--;
        }
    }

    private void GoContinue()
    {
        if (IsLastPage)
        {
            return;
        }

        // Gate page navigation on the current page's answers only; later pages are not
        // yet in view, so their questions must not block "Continue".
        var pageQuestionIds = ActivePage.Questions.Select(q => q.Id).ToHashSet();
        var pageErrors = SubmissionValidator.Validate(_form!, _answers)
            .Where(pair => pageQuestionIds.Contains(pair.Key))
            .ToDictionary(pair => pair.Key, pair => pair.Value);

        if (pageErrors.Count > 0)
        {
            _errors = pageErrors;
            return;
        }

        _errors = [];
        _currentPageIndex++;
    }

    private void OnAnswerChanged(Guid questionId, object? value)
    {
        _answers[questionId] = value;

        // Drop this question's error the moment the respondent edits it, mirroring the
        // builder's IHasIssues.Edit behaviour; it is re-checked on the next Continue / Submit.
        _errors.Remove(questionId);
    }

    private int FirstInvalidPageIndex()
    {
        for (var i = 0; i < _form!.Pages.Count; i++)
        {
            if (_form.Pages[i].Questions.Any(q => _errors.ContainsKey(q.Id)))
            {
                return i;
            }
        }

        return _currentPageIndex;
    }

    // async Task (never async void) so Blazor awaits it and re-renders on completion.
    private async Task Submit()
    {
        if (_form is null || _submitting || _submitted)
        {
            return;
        }

        // Nothing is published until every answer clears its question's constraints; the
        // async RabbitMQ hop (ADR 0009) leaves the client as the only place to enforce them.
        var errors = SubmissionValidator.Validate(_form, _answers);
        if (errors.Count > 0)
        {
            _errors = new Dictionary<Guid, string>(errors);
            _currentPageIndex = FirstInvalidPageIndex();
            return;
        }

        _errors = [];
        _submitting = true;
        try
        {
            await SubmissionPublisher.PublishAsync(new FormSubmissionRequest
            {
                FormId = _form.Id,
                FormVersionNumber = _form.VersionNumber,
                Answers = BuildAnswers(),
            });
            _submitted = true;
        }
        catch (Exception ex)
        {
            // RabbitMqSubmissionPublisher rethrows on a broker/channel/serialization failure;
            // the submission is not recorded and the respondent stays on the last page.
            Logger.LogError(ex, "Submission publish failed for form {FormId}.", FormId);
        }
        finally
        {
            _submitting = false;
        }
    }

    private List<SubmissionAnswerDto> BuildAnswers()
    {
        var answers = new List<SubmissionAnswerDto>();
        var order = 0;

        foreach (var question in _form!.Pages.SelectMany(p => p.Questions))
        {
            var value = _answers.GetValueOrDefault(question.Id);

            switch (question)
            {
                // Must precede the ChoiceQuestionDto cases — it also derives from it.
                // One row per chosen option; no rows when nothing is picked.
                case CheckBoxGroupQuestionDto:
                    foreach (var optionId in value as IReadOnlySet<Guid> ?? new HashSet<Guid>())
                    {
                        answers.Add(new OptionAnswerDto
                        {
                            QuestionId = question.Id,
                            QuestionText = question.Text,
                            Order = order++,
                            OptionId = optionId,
                        });
                    }
                    break;

                case ChoiceQuestionDto when value is Guid selectedId:
                    answers.Add(new OptionAnswerDto
                    {
                        QuestionId = question.Id,
                        QuestionText = question.Text,
                        Order = order++,
                        OptionId = selectedId,
                    });
                    break;

                case ChoiceQuestionDto:
                    break; // nothing selected

                case CheckboxQuestionDto:
                    answers.Add(new BooleanAnswerDto
                    {
                        QuestionId = question.Id,
                        QuestionText = question.Text,
                        Order = order++,
                        Checked = value is true,
                    });
                    break;

                case TextAreaQuestionDto:
                case NumberQuestionDto:
                case CalendarQuestionDto:
                    answers.Add(new ValueAnswerDto
                    {
                        QuestionId = question.Id,
                        QuestionText = question.Text,
                        Order = order++,
                        Value = value as string,
                    });
                    break;
            }
        }

        return answers;
    }
}
